# ==============================================================================
# FinPulse Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# --- Application ---
APP_NAME=FinPulse
APP_ENV=development           # Options: development | staging | production
APP_VERSION=0.1.0
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8005

# --- Database ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://finpulse:finpulse_secret@localhost:5434/finpulse_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Logging ---
LOG_LEVEL=INFO                # Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json               # Options: json | text

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- External APIs ---
# (Reserved for future yFinance or other market data API keys)
# ALPHA_VANTAGE_API_KEY=your-key-here

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3005","http://localhost:5173"]
